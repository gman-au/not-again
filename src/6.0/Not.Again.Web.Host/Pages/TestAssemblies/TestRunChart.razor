@using Not.Again.Contracts
@using Not.Again.Enum
<BarChart @ref="_barChart" Width="500" Height="300" />

@code {
    [Parameter]
    public IEnumerable<ReportableTestRun> TestRuns { get; set; }

    private BarChart _barChart = null!;
    private BarChartOptions _barChartOptions = null!;
    private ChartData _chartData = null!;

    protected override void OnInitialized()
    {
        if (!(TestRuns ?? Enumerable.Empty<ReportableTestRun>()).Any())
            return;

        var colors = ColorUtility.CategoricalSixColors;

        var labels =
            TestRuns
                .Select(o => o.RunDate.ToString("d"))
                .Distinct()
                .ToList();

        var datasets = new List<IChartDataset>();

        // for each test run, build a data set
        var distinctTestIds =
            TestRuns
                .Select(o => o.TestId)
                .Distinct()
                .ToList();

        var colorIndex = 0;
        // iterate through tests
        foreach (var testId in distinctTestIds)
        {
            var test =
                TestRuns
                    .FirstOrDefault(o => o.TestId == testId);

            var testName =
                test?
                    .TestName;

            var seriesData = new List<double?>();

            // iterate through distinct dates
            foreach (var label in labels)
            {
                var testPassesOnThisDate =
                    TestRuns
                        .Where(o => o.RunDate.ToString("d") == label)
                        .Count(o => o.Status == (int)TestResultEnum.Passed);

                seriesData
                    .Add(testPassesOnThisDate);
            }

            datasets.Add(new BarChartDataset
            {
                Label = testName,
                Data = seriesData,
                BackgroundColor = new List<string> { colors[colorIndex] },
                BorderColor = new List<string> { colors[colorIndex] },
                BorderWidth = new List<double> { 0 },
            });

            colorIndex = (colorIndex + 1) % 6;
        }

        _chartData = new ChartData { Labels = labels, Datasets = datasets };

        _barChartOptions = new();
        _barChartOptions.Responsive = true;
        _barChartOptions.Interaction = new Interaction { Mode = InteractionMode.Y };
        _barChartOptions.IndexAxis = "x";

        _barChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "Count", Display = true };
        _barChartOptions.Scales.X!.Title = new ChartAxesTitle { Text = "Test", Display = true };

        _barChartOptions.Scales.X.Stacked = true;
        _barChartOptions.Scales.Y.Stacked = true;

        _barChartOptions.Plugins.Title!.Text = "Test runs";
        _barChartOptions.Plugins.Title.Display = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _barChart.InitializeAsync(_chartData, _barChartOptions);
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}
